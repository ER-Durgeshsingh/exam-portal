# Supabase: Project -> Connect -> "Session pooler" wali URI yahan paste karo
# (password me special characters ho to URL-encode karo, jaise @ -> %40)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
JWT_SECRET=koi_lamba_random_text_yahan_daalo
# Frontend ka URL (deploy ke baad Vercel wala URL, aakhir me / nahi)
CLIENT_URL=http://localhost:5173
PORT=5000
